# Copy this file to APP_DIR/.env.prod on the server and keep it out of Git.
# Replace DATABASE_NAME with the exact name of the existing production database.
# The ecto:// format works for PostgreSQL and MySQL; the application's Ecto adapter selects the engine.
DATABASE_URL="ecto://DATABASE_USER:DATABASE_PASSWORD@localhost/DATABASE_NAME"
SECRET_KEY_BASE="GENERATE_WITH_MIX_PHX_GEN_SECRET"
PHX_HOST="example.com"
PORT="4000"
HEALTH_CHECK_ENABLED="true"
POOL_SIZE="10"
FORCE_SSL="true"
RELEASES_TO_KEEP="5"

# Add every runtime dependency here. For example:
# FACE_SEARCH_URL="http://127.0.0.1:5000"
# S3_BUCKET="my-production-bucket"
